# ====================================================================
# PRODUCTION & LOCAL ENVIRONMENT CONFIGURATION
# Online Crockery Store (Pakistan)
# ====================================================================

# Next.js App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --------------------------------------------------------------------
# 1. Supabase (Database, Auth, Storage)
# --------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --------------------------------------------------------------------
# 2. Resend (Transactional Email)
# --------------------------------------------------------------------
RESEND_API_KEY=re_123456789
RESEND_FROM_EMAIL=Almoin Store <orders@almoinstore.pk>

# --------------------------------------------------------------------
# 3. Pakistani Online Payment Gateway (Sandbox Mode)
# Provider option: "safepay" or "payfast"
# --------------------------------------------------------------------
PAYMENT_GATEWAY_PROVIDER=safepay

# Safepay Sandbox API v2 credentials
SAFEPAY_API_KEY=sec_sand_xxxxxxx
SAFEPAY_SECRET_KEY=sand_shared_secret_xxxxxxx
SAFEPAY_ENV=sandbox
NEXT_PUBLIC_SAFEPAY_URL=https://sandbox.api.getsafepay.com

# PayFast credentials (alternative)
PAYFAST_MERCHANT_ID=100000
PAYFAST_SECURED_KEY=sand_secured_key_xxxx

# --------------------------------------------------------------------
# 4. Bank Transfer / JazzCash / Easypaisa Accounts (Displayed in Checkout)
# --------------------------------------------------------------------
NEXT_PUBLIC_BANK_NAME="Meezan Bank Limited"
NEXT_PUBLIC_BANK_TITLE="ALMOIN STORE"
NEXT_PUBLIC_BANK_IBAN="PK12MEZN0001020304050607"

NEXT_PUBLIC_JAZZCASH_TITLE="ALMOIN STORE"
NEXT_PUBLIC_JAZZCASH_NUMBER="03001234567"

NEXT_PUBLIC_EASYPAISA_TITLE="ALMOIN STORE"
NEXT_PUBLIC_EASYPAISA_NUMBER="03451234567"

# --------------------------------------------------------------------
# 5. Store Operations & Fragile Crockery Logistics
# --------------------------------------------------------------------
NEXT_PUBLIC_WHATSAPP_NUMBER=+923001234567
NEXT_PUBLIC_STORE_NAME="Almoin Store"
NEXT_PUBLIC_STORE_EMAIL="support@almoinstore.pk"
NEXT_PUBLIC_STORE_PHONE="+92 21 35812345"

# Pricing & Fee Defaults (in PKR Integer)
NEXT_PUBLIC_DEFAULT_COD_FEE=150
NEXT_PUBLIC_MAX_COD_LIMIT=35000
NEXT_PUBLIC_FRAGILE_PACKAGING_FEE=250
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD=5000

# --------------------------------------------------------------------
# 6. Admin Portal Authentication & Session Security
# --------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-strong-admin-password
ADMIN_SESSION_SECRET=replace-with-openssl-rand-hex-32

# --------------------------------------------------------------------
# 7. Free Cloud Product Image Hosting (Cloudinary Signed Uploads)
# --------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name
CLOUDINARY_UPLOAD_PRESET=
IMGBB_API_KEY=
